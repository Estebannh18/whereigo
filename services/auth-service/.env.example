# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Base de datos ---
# Desarrollo local (Postgres nativo o Docker): usa las variables sueltas de abajo.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=whereigo
DB_PASSWORD=changeme
DB_NAME=whereigo_auth
# Nunca usar en producción: sincroniza el esquema automáticamente, solo para desarrollo.
DB_SYNCHRONIZE=true

# En Render (producción): NO definas las DB_* de arriba. Render inyecta automáticamente
# DATABASE_URL al conectar la base de datos administrada desde el dashboard/render.yaml;
# si esta variable existe, app.module.ts la usa en su lugar (con TLS habilitado).
# DATABASE_URL=postgres://usuario:password@host:5432/basededatos

# --- Seguridad de contraseñas ---
BCRYPT_SALT_ROUNDS=10

# --- JWT ---
# Genera valores fuertes y distintos para cada entorno, ej: openssl rand -base64 48
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Usuario admin demo (lo crea el seed si el correo no existe) ---
# Definir SIEMPRE en Render (si no existen, el seed usa su clave por defecto).
# No dejarlas vacías: una clave vacía crearía el admin sin contraseña.
# DEMO_ADMIN_EMAIL=admin@whereigo.dev
# DEMO_ADMIN_PASSWORD=una-clave-fuerte

# --- Monitoreo (Prometheus) ---
# /metrics solo responde con "Authorization: Bearer <METRICS_TOKEN>". Vacío = /metrics cerrado.
# Genera uno con: openssl rand -hex 32
METRICS_TOKEN=
