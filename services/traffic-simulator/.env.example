# services/traffic-simulator/.env.example
# URL del traffic-service al que enviar lecturas.
TRAFFIC_SERVICE_URL=http://localhost:3002

# Intervalo entre rondas de generación de datos (milisegundos).
SIMULATOR_INTERVAL_MS=5000

# Probabilidad de lluvia en cada ronda (0.0 - 1.0).
RAIN_PROBABILITY=0.15

# Probabilidad de incidente por segmento en cada ronda (0.0 - 1.0).
INCIDENT_PROBABILITY=0.02

# Horas pico: inicio y fin (formato HH:mm, zona horaria local del contenedor).
MORNING_PEAK_START=06:30
MORNING_PEAK_END=09:00
EVENING_PEAK_START=17:00
EVENING_PEAK_END=20:00
