# services/traffic-service/.env.example
# Copiar a .env y ajustar valores.

PORT=3002
NODE_ENV=development

# Base de datos propia del servicio (misma instancia Postgres, esquema separado).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=whereigo
DB_PASSWORD=changeme
DB_NAME=whereigo_traffic
DB_SYNCHRONIZE=true

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=whereigo
RABBITMQ_PASSWORD=changeme
RABBITMQ_EXCHANGE=traffic.events
RABBITMQ_ENABLED=true

# En Render (producción): Render inyecta DATABASE_URL; app.module.ts la usa en su lugar.
# DATABASE_URL=postgres://usuario:password@host:5432/basededatos
