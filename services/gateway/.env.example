PORT=3000
NODE_ENV=development

# URL interna del microservicio de autenticación.
# - docker-compose local: http://auth-service:3001 (nombre del servicio en la red de Docker)
# - Render: la URL pública HTTPS que Render le asigna al servicio auth-service
#   (ej. https://whereigo-auth-service.onrender.com), sin barra final.
AUTH_SERVICE_URL=http://auth-service:3001

# URL interna del microservicio de tráfico.
# - docker-compose local: http://traffic-service:3002
# - Render: la URL pública HTTPS del servicio traffic-service.
TRAFFIC_SERVICE_URL=http://traffic-service:3002

# URL interna del microservicio de alertas.
# - docker-compose local: http://alert-service:3003
# - Render: la URL pública HTTPS del servicio alert-service.
ALERT_SERVICE_URL=http://alert-service:3003

# Debe coincidir EXACTAMENTE con JWT_ACCESS_SECRET de auth-service: el gateway
# valida la firma del access token antes de reenviar a rutas protegidas.
JWT_ACCESS_SECRET=change_this_access_secret

# Orígenes permitidos para CORS, separados por coma.
# En producción agrega el dominio de Vercel, ej:
# CORS_ORIGINS=http://localhost:5173,https://whereigo.vercel.app
CORS_ORIGINS=http://localhost:5173
