# services/ai-service/.env.example
PORT=8000
HOST=0.0.0.0

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=whereigo
RABBITMQ_PASSWORD=changeme
RABBITMQ_EXCHANGE=traffic.events
RABBITMQ_ENABLED=true

# --- Modelo de IA ---
# Versión que se reporta en /health, /predict, las métricas y las alertas.
MODEL_VERSION=tinymlp-1.1

# --- Monitoreo (Prometheus) ---
# /metrics solo responde con "Authorization: Bearer <METRICS_TOKEN>". Vacío = /metrics cerrado.
# Genera uno con: openssl rand -hex 32
METRICS_TOKEN=
