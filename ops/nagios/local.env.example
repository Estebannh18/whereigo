# ops/nagios/local.env.example
# MODO LOCAL: Nagios vigila el stack de `docker compose up -d` (plan B de la demo,
# o para practicar sin gastar horas de Render).
#
#   cp ops/nagios/local.env.example ops/nagios/.env      # y completar lo marcado
#   docker compose -f ops/nagios/docker-compose.yml -f ops/nagios/docker-compose.local.yml up -d --build
#   http://localhost:8080/nagios
#
# Aquí NUNCA van valores reales de producción.

# --- Panel web de Nagios (solo se aplica en el primer arranque del volumen) ---
NAGIOSADMIN_USER=nagiosadmin
NAGIOSADMIN_PASS=

# --- Modo local: http, puerto de cada contenedor y vigilancia 24x7 ---
WHEREIGO_SCHEME=http
WHEREIGO_PERIOD=whereigo-24x7

# Nombres de servicio del docker-compose.yml de la raíz (red whereigo_default).
WHEREIGO_GATEWAY_HOST=gateway
WHEREIGO_GATEWAY_PORT=3000
WHEREIGO_AUTH_HOST=auth-service
WHEREIGO_AUTH_PORT=3001
WHEREIGO_AI_HOST=ai-service
WHEREIGO_AI_PORT=8000
# El frontend corre con Vite en el equipo (npm run dev, puerto 5173).
WHEREIGO_FRONTEND_HOST=host.docker.internal
WHEREIGO_FRONTEND_PORT=5173

WHEREIGO_REPO_URL=https://github.com/Estebannh18/whereigo

# --- Telegram (opcional en local: vacío = solo se ve en el panel) ---
TELEGRAM_BOT_TOKEN=
WHEREIGO_TELEGRAM_CHAT_JUANJO=0
WHEREIGO_TELEGRAM_CHAT_JUANES=0

# --- Cuenta de monitoreo (créala antes con POST http://localhost:3000/auth/register) ---
MONITOR_USER_EMAIL=
MONITOR_USER_PASSWORD=

# En local no hay deploy hooks: el event handler no redespliega nada.
