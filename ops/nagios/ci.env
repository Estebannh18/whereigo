NAGIOSADMIN_PASS=solo-para-ci
WHEREIGO_FRONTEND_HOST=frontend.example.com
WHEREIGO_GATEWAY_HOST=gateway.example.com
WHEREIGO_AUTH_HOST=auth.example.com
WHEREIGO_AI_HOST=ai.example.com
WHEREIGO_REPO_URL=https://github.com/ejemplo/whereigo
WHEREIGO_TELEGRAM_CHAT_JUANJO=0
WHEREIGO_TELEGRAM_CHAT_JUANES=0
