# ops/nagios/.env.example
# Copiar como ops/nagios/.env (ignorado por git) y completar. Aquí NUNCA van valores reales.

# --- Panel web de Nagios (solo se aplica en el primer arranque) ---
NAGIOSADMIN_USER=nagiosadmin
NAGIOSADMIN_PASS=

# --- Hosts a vigilar (solo el dominio, sin https:// ni barra final) ---
# Frontend, gateway y los dos microservicios del ciclo de vida (auth e IA).
WHEREIGO_FRONTEND_HOST=
WHEREIGO_GATEWAY_HOST=
WHEREIGO_AUTH_HOST=
WHEREIGO_AI_HOST=

# Repositorio en GitHub, para los enlaces al runbook (sin barra final)
WHEREIGO_REPO_URL=

# --- Notificaciones por Telegram ---
TELEGRAM_BOT_TOKEN=
WHEREIGO_TELEGRAM_CHAT_JUANJO=
WHEREIGO_TELEGRAM_CHAT_JUANES=

# --- Cuenta de monitoreo para la transacción login -> ETA (rol user, sin datos reales) ---
MONITOR_USER_EMAIL=
MONITOR_USER_PASSWORD=

# --- Deploy hooks de Render (auto-remediación). Vacío = no redesplegar ese servicio ---
RENDER_HOOK_GATEWAY=
RENDER_HOOK_AUTH=
RENDER_HOOK_AI=
